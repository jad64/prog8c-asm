label {

	%option merge

	;----------------------------------------------
	;  str_get_crc()
	;----------------------------------------------
	asmsub str_get_crc(ubyte length @X) -> ubyte @A {
		%asm {{

			txa
			clc
-			adc		p8b_util.p8v_string-1,x
			dex
			bne		-
			rts
		}}
	}
}
